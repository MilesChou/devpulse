# DevPulse configuration. Copy to .env and fill in.

# Connection string. Forms supported:
#   postgres://user:pass@host:5432/db?sslmode=disable
#   mysql://user:pass@host:3306/db?parseTime=true
#   sqlite://./devpulse.db?_fk=true
#   memory                                (in-memory SQLite, fresh per run)
DEVPULSE_DSN=memory

# External API credentials.
# GITHUB_TOKEN: pull PR / review / commit author data.
#   Generate at https://github.com/settings/tokens (needs repo + read:user).
GITHUB_TOKEN=

# TRAVIS_TOKEN (optional): also pull Travis CI build history. Without it
#   only GitHub Actions runs are synced.
#   Account Settings -> API authentication on https://app.travis-ci.com.
TRAVIS_TOKEN=

# Logging.
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry (optional). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_SAMPLE_RATE=1.0
SERVICE_VERSION=dev
ENV=local

# HTTP client tuning.
# HTTP_TIMEOUT applies to both GitHub and Travis clients.
# HTTP_RETRY_MAX applies only to the Travis client. The GitHub client uses
# go-gh, which does not implement retries; the GitHub client currently does
# not retry on any failure (5xx, network errors, or GitHub rate limits).
HTTP_TIMEOUT=30s
HTTP_RETRY_MAX=3

# HTTP response cache (optional, off by default). Successful API responses
# are stored on disk; entries past CACHE_TTL revalidate with ETag (a 304
# costs no GitHub rate limit). CACHE_TTL=0 is replay mode: entries never
# expire — only for rebuilding the DB offline, never for routine syncing.
# CACHE_ENABLED=true
# CACHE_DIR=
# CACHE_TTL=24h

