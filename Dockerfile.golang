# Multi-stage Dockerfile for the Go rewrite.
# Original PHP `Dockerfile` is left in place until Stage 10.

FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOFLAGS=-mod=mod
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN go build -ldflags='-s -w' -o /out/devpulse ./cmd/devpulse

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/devpulse /usr/local/bin/devpulse
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/devpulse"]

