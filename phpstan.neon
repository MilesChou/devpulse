# See https://github.com/larastan/larastan
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    tmpDir: .phpstan.result.cache
    level: 10
    paths:
        - app/
        - src/
    phpat:
        ignore_built_in_classes: true
        show_rule_names: true

services:
    -
        class: Tests\Domain\Architecture\DomainProductionPurityTest
        tags:
            - phpat.test
    -
        class: Tests\Domain\Architecture\DomainTestPurityTest
        tags:
            - phpat.test
