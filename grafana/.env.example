# devpulse PostgreSQL DSN
# 注意：若 PG 跑在 host 機器（localhost），這裡要填 host.docker.internal（macOS / Windows）
# 或 host 機器在 docker network 中的 IP（Linux）。遠端 PG 直接填實際 host 即可。
DEVPULSE_DB_HOST=host.docker.internal
DEVPULSE_DB_PORT=5432
DEVPULSE_DB_NAME=devpulse
DEVPULSE_DB_USER=devpulse
DEVPULSE_DB_PASSWORD=changeme
# sslmode 只接受四個值：disable / require / verify-ca / verify-full
# 雲端 PG（Supabase / Neon / RDS 等）通常要填 require
# 本機 PG 不開 SSL 才填 disable
DEVPULSE_DB_SSLMODE=disable
